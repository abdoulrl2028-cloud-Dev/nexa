# ===== NEXA — exemplo de configuração =====
# Copia este arquivo a `.env` e ajusta. NUNCA comitees `.env`.
# Todas as chaves são lidas daqui; a app usa defaults sensatos p/ dev.

# Ambientes: development | staging | production
NEXA_ENV=development

# Chave secreta para JWT e assinaturas de cookie (gerar com `openssl rand -hex 32`).
# OBLIGATORIA em staging / production.
SECRET_KEY=

# Dominios públicos (um por ambiente). Em desarrollo local basta localhost.
SITE_URL=http://localhost:8000
WWW_HOST=localhost
API_HOST=localhost

# Banco de datos
#  - Desarrollo:      sqlite:///nexa-dev.db  (default si se omite)
#  - Producción/CI:   postgresql+psycopg://usuario:clave@host:5432/nexa
DATABASE_URL=

# Redis opcional (sessions/cache/límite de tasa). Sin REDIS_URL usa cache en memoria.
# REDIS_URL=redis://localhost:6379/0

# Almacenamiento de archivos: local (default) | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=data/uploads

# Object storage S3-compatible (solo si STORAGE_DRIVER=s3)
# Credenciales AWS via AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (no codificar).
# S3_BUCKET=nexa-media
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_PUBLIC_BASE=

# Subidas
MAX_UPLOAD_MB=25

# Registro abierto (cerrar en producción p/ invitaciones si se desea)
ALLOW_REGISTRATION=true

# Tiempos de token (minutos de acceso / días de refresh)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30