{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXA",
  "version": "0.1.0",
  "identifier": "com.nexa.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:8000",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "NEXA",
        "width": 1100,
        "height": 760,
        "minWidth": 360,
        "minHeight": 600,
        "url": "http://localhost:8000"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://localhost:8000 http://localhost:8000; img-src 'self' data: blob: http://localhost:8000"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}