# ===== NEXA — Caddy (reverse proxy + TLS automático + catch-all SSR) =====
# Uso: docker run com Caddy e montar este Caddyfile.
# www.site.com  ->  NEXA xyz (a própria app serve /app/*, /post/*, sitemap, etc.)
# A app é SSR: NÃO há separação frontend/backend; TUDO aponta para a API.

www.nexa-example.com {
	# Comprime respostas textuais (HTML/CSS/JS/JSON)
	encode gzip

	# Headers de segurança
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		# CSP razoável: api/self/media/cdn + ws para realtime
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https://*.nextauth.media; connect-src 'self' wss://; style-src 'self' 'unsafe-inline'; script-src 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	# Cache de estáticos (ícones, sw, css/js) — imutáveis
	@static path /static/* /icons/* /manifest.json /sw.js
	header @static Cache-Control "public, max-age=31536000, immutable"

	handle {
		reverse_proxy api:8000
	}
}

# Entrada de API/mídia (opcional se quiser separar domínio api.*)
api.nexa-example.com {
	encode gzip
	reverse_proxy api:8000
}